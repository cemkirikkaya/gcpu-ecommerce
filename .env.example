# =============================================================================
# GCPU — Laravel backend (.env)
# Kurulum: cp .env.example .env && php artisan key:generate
# Frontend için ayrıca: cp frontend/.env.local.example frontend/.env.local
# =============================================================================

APP_NAME=GCPU
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

WWWUSER=501
WWWGROUP=20

FRONTEND_URL=http://localhost:3000
FRONTEND_PORT=3000
SHOP_NAME=GCPU

# Mağaza ayarları (config/shop.php)
SHOP_RESERVATION_MINUTES=15
SHOP_LOW_STOCK_THRESHOLD=5
# SHOP_INVOICE_LEGAL_NAME=
# SHOP_INVOICE_TAX_OFFICE=
# SHOP_INVOICE_TAX_NUMBER=
# SHOP_INVOICE_ADDRESS=
# SHOP_INVOICE_EMAIL=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# PostgreSQL (Sail). Host makineden artisan: DB_HOST=127.0.0.1 DB_PORT=5433
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5433
DB_DATABASE=laravel
DB_USERNAME=sail
DB_PASSWORD=password
FORWARD_DB_PORT=5432
# DB_CONNECTION=sqlite  # Docker kullanmıyorsanız

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
# Ürün görselleri Storage::disk('public') ile kaydedilir; varsayılan disk ayrı kalır
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Gerçek e-posta (Gmail örneği — uygulama şifresi gerekir):
# MAIL_MAILER=smtp
# MAIL_SCHEME=smtp
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USERNAME=your@gmail.com
# MAIL_PASSWORD="your 16 char app password"
# MAIL_FROM_ADDRESS=your@gmail.com
# MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# -----------------------------------------------------------------------------
# Frontend (Docker compose.yaml bu değerleri frontend container'a aktarır)
# Yerel npm run dev için asıl kaynak: frontend/.env.local
# -----------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost/api
NEXT_PUBLIC_MEDIA_URL=http://localhost
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# SANCTUM_STATEFUL_DOMAINS=localhost,localhost:3000,127.0.0.1

# -----------------------------------------------------------------------------
# Iyzico (ödeme)
# Local geliştirmede IYZICO_FAKE=true önerilir; production'da false yapın
# -----------------------------------------------------------------------------
IYZICO_API_KEY=
IYZICO_SECRET_KEY=
IYZICO_BASE_URL=https://sandbox-api.iyzipay.com
IYZICO_CALLBACK_URL="${APP_URL}/payment/iyzico/callback"
IYZICO_FRONTEND_RESULT_URL="${FRONTEND_URL}/payment/result"
IYZICO_FAKE=true
IYZICO_DIRECT=false
IYZICO_ENABLED=true
IYZICO_TEST_CARD_NUMBER=4543590000000006
IYZICO_TEST_CARD_EXPIRE_MONTH=12
IYZICO_TEST_CARD_EXPIRE_YEAR=2030
IYZICO_TEST_CARD_CVC=123
IYZICO_TEST_CARD_HOLDER="Test Card"

# -----------------------------------------------------------------------------
# Stripe (ödeme)
# Local geliştirmede STRIPE_FAKE=true yeterlidir
# -----------------------------------------------------------------------------
STRIPE_ENABLED=true
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=try
STRIPE_FAKE=true
STRIPE_SUCCESS_URL="${FRONTEND_URL}/payment/result?status=success"
STRIPE_CANCEL_URL="${FRONTEND_URL}/payment/result?status=failed"

# -----------------------------------------------------------------------------
# Geliver (kargo)
# Webhook: https://<api-adresiniz>/api/webhooks/geliver (yerelde ngrok gerekir)
# -----------------------------------------------------------------------------
GELIVER_API_TOKEN=
GELIVER_SENDER_ADDRESS_ID=
GELIVER_FAKE=true
GELIVER_TEST=true
GELIVER_AUTO_CREATE_ON_PAYMENT=true
GELIVER_SYNC_STATUS_FROM_WEBHOOK=true
GELIVER_AUTO_SYNC_FROM_API=true
# Test modunda API placeholder (example.com) dönerse müşteri takip linki buraya fallback eder
GELIVER_TRACKING_PAGE_BASE=https://app.geliver.io/tracking
# Varsayılan paket ölçüleri (cm / kg) — teklif hesaplamasında kullanılır
GELIVER_DEFAULT_WEIGHT=1.0
GELIVER_DEFAULT_LENGTH=30.0
GELIVER_DEFAULT_WIDTH=20.0
GELIVER_DEFAULT_HEIGHT=10.0

# -----------------------------------------------------------------------------
# Google OAuth (opsiyonel)
# Google Cloud Console → Authorized JavaScript origins: http://localhost:3000
# -----------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/api/auth/google/callback"
