# =============================================================================
# GCPU — Next.js frontend (.env.local)
# Kurulum: cp .env.local.example .env.local
#
# Docker compose kullanıyorsanız kök .env içindeki NEXT_PUBLIC_* değerleri
# compose.yaml ile container'a aktarılır; yine de bu dosyayı oluşturmanız önerilir.
# =============================================================================

# Tarayıcının eriştiği API (mağaza + admin)
NEXT_PUBLIC_API_URL=http://localhost/api

# Frontend kök URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Ürün görselleri — Laravel /storage/... yolunun kökü (kırık görsel olmaması için gerekli)
NEXT_PUBLIC_MEDIA_URL=http://localhost

# SSR / Docker içinden API erişimi
# - npm run dev (host): http://localhost/api
# - Docker compose: http://host.docker.internal/api (compose.yaml otomatik ayarlar)
API_INTERNAL_URL=http://localhost/api

# Google ile giriş (boş bırakılırsa buton gizlenir)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Opsiyonel vitrin videoları
# NEXT_PUBLIC_HERO_VIDEO_URL=
# NEXT_PUBLIC_HOME_VIDEO_URL=
